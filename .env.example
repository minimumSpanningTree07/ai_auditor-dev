# Copy to .env and set your own values. Never commit .env.
POSTGRES_DB=invoice_auditor
POSTGRES_USER=invoice_user
POSTGRES_PASSWORD=replace_with_a_long_random_password

AWS_REGION=us-east-1
# Prefer the existing ~/.aws/config and ~/.aws/credentials profile when available.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

LLM_MODEL=bedrock/amazon.nova-lite-v1:0
RAG_MODEL=bedrock/amazon.nova-lite-v1:0
TRANSLATION_MODEL=bedrock/amazon.nova-lite-v1:0
EMBEDDING_MODEL=bedrock/amazon.titan-embed-text-v1
EMBEDDING_DIMENSION=1536
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1000
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.70
RAG_MAX_RETRIES=3
OCR_LANGUAGES=eng+vie
QDRANT_COLLECTION=invoice_documents

AGENT_HOST=0.0.0.0
AGENT_PORT=8000
MOCK_ERP_URL=http://mock-erp:8000
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
QDRANT_HOST=qdrant
QDRANT_PORT=6333
