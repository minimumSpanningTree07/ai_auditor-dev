# Copy to .env and set a strong local password before starting the stack.
POSTGRES_DB=invoice_auditor
POSTGRES_USER=invoice_auditor_app
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
AWS_REGION=us-east-1
# Supply AWS credentials through your normal secure environment/credential chain.
# Do not commit real credentials. If using static keys, set them locally in .env.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
LLM_MODEL=bedrock/amazon.nova-lite-v1:0
OCR_LANGUAGES=eng+spa+deu
QDRANT_COLLECTION=invoice_documents
